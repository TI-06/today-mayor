import {createInitialState,normalizeState,isV07State} from './game/state.js';
import {FOCUS_OPTIONS,DELEGATION_OPTIONS,selectWeeklyFocus,setDelegationPolicy} from './game/focus.js';
import {createWeeklyGoals,selectManifesto,MANIFESTESTOS,evaluateGoals,evaluateTerm,electionScore} from './game/goals.js';
import {choosePolicyCase,applyPolicyChoice,getPolicyCase} from './game/policies.js';
import {advancePhase} from './game/week-engine.js';
import {financeStatus,forecastNextTreasury,issueBond,transferReserve} from './game/finance.js';
import {EVENTS,getEvent} from './events/content.js';
import {selectEventPreview,startEventPipeline,investigateEvent,respondToEvent,resolveEventFollowup} from './events/engine.js';
import {PROJECTS,getProject,startProject,advanceProjects,pauseProject,cancelRecurringPolicy,investDistrict} from './game/projects.js';
import {availableStoryNodes,resolveStoryChoice} from './characters/stories.js';
import {getStory} from './characters/content.js';
import {deriveCityVisualState} from './city/visual-state.js';
import {renderMoneyBar,renderExpensePreview,escapeHtml,formatMoney,signedMoney} from './ui/components.js';
import {renderHomeView} from './ui/home-view.js';
import {renderCityView} from './ui/city-view.js';
import {renderPolicyView} from './ui/policy-view.js';
import {renderResidentView} from './ui/resident-view.js';
import {renderRecordsView} from './ui/records-view.js';
import {COSMETICS} from './content.js';
import {getCloudStatus,getCurrentUser,registerUser,loginUser,logoutUser,loadV07CloudState,saveCloudState,submitChoice,fetchRanking,submitRanking} from './cloud.js';
import {showRewardedAd,purchaseProduct} from './monetization.js';

const KEY='today-mayor-v07';
const TABS=['home','city','policy','residents','records'];
const app=document.querySelector('#app');
const actionSheet=document.querySelector('#action-sheet');
const menuDialog=document.querySelector('#menu-dialog');
const toast=document.querySelector('#toast');

let state=loadLocalState();
let activeTab='home';
let ranking=[];
let syncTimer=null;
let uiState={currentPolicyId:null,reaction:null};
let cloud={available:false,syncing:false,lastSync:null,user:null};

function loadLocalState(){
  try{return normalizeState(JSON.parse(localStorage.getItem(KEY)))}catch{return createInitialState()}
}

function updateRank(){
  const average=(state.support+state.economy+state.life+state.environment+state.safety)/5;
  const rank=average>=78?'街を変えた市長':average>=66?'敏腕市長':average>=54?'期待の市長':average>=40?'見習い市長':'崖っぷち市長';
  state={...state,rank,projectedTreasury:forecastNextTreasury(state)};
}

function save(){
  updateRank();
  localStorage.setItem(KEY,JSON.stringify(state));
  scheduleCloudSave();
}

function scheduleCloudSave(){
  if(!cloud.available)return;
  clearTimeout(syncTimer);
  syncTimer=setTimeout(async()=>{
    cloud.syncing=true;render();
    try{
      await saveCloudState(state);
      await submitRanking(state);
      cloud.lastSync=new Date().toISOString();
    }catch{cloud.available=false}
    finally{cloud.syncing=false;render()}
  },650);
}

function showToast(message,type='info'){
  toast.textContent=message;
  toast.className=`toast show ${type}`;
  clearTimeout(showToast.timer);
  showToast.timer=setTimeout(()=>{toast.className='toast'},2600);
}

function openSheet(title,content,modifier=''){
  if(actionSheet.open)actionSheet.close();
  actionSheet.className=`action-sheet ${modifier}`;
  actionSheet.innerHTML=`<div class="sheet-grabber"></div><header class="sheet-header"><div><p>WEEKLY DECISION</p><h2>${escapeHtml(title)}</h2></div><button class="close-action" data-sheet-close aria-label="閉じる">×</button></header><div class="sheet-body">${content}</div>`;
  actionSheet.showModal();
}

function closeSheet(){if(actionSheet.open)actionSheet.close()}
const activePipeline=stage=>state.eventPipelines.find(item=>item.stage===stage);
const projectPhaseAvailable=()=>state.phase==='project';

function resolveDueFollowups(){
  for(const pipeline of [...state.eventPipelines]){
    if(pipeline.stage==='followup'&&(pipeline.followupWeek??Infinity)<=state.week){
      const result=resolveEventFollowup(state,pipeline.eventId,Math.random);
      if(!result.error)state=result.state;
    }
  }
}

function viewMarkup(){
  const common={cloud,ranking,reaction:uiState.reaction};
  if(activeTab==='home')return renderHomeView(state,common);
  if(activeTab==='city')return renderCityView(state,common);
  if(activeTab==='policy')return renderPolicyView(state,common);
  if(activeTab==='residents')return renderResidentView(state,common);
  return renderRecordsView(state,common);
}

function render(){
  const account=cloud.user?`👤 ${escapeHtml(cloud.user.username)}`:'ゲスト';
  app.className=`app-shell skin-${state.equippedSkin}`;
  app.innerHTML=`<header class="topbar"><div><p>MAYOR'S OFFICE</p><h1>今日の市長</h1></div><div class="top-actions"><span class="account-chip">${account}</span><i class="cloud-dot ${cloud.available?'online':'offline'} ${cloud.syncing?'syncing':''}"></i><button class="menu-action" data-action="menu">⋯</button></div></header>${renderMoneyBar(state)}${viewMarkup()}<nav class="bottom-nav">${[['home','🏛️','ホーム'],['city','🏙️','街'],['policy','📋','政策'],['residents','👥','市民'],['records','📰','記録']].map(([id,icon,label])=>`<button class="nav-item ${activeTab===id?'active':''}" data-tab="${id}"><span>${icon}</span><small>${label}</small></button>`).join('')}</nav>`;
}
