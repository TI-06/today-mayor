ircle at 80% 72%,rgba(99,164,91,.3),transparent 20%)}
.ponkichi-panel{display:grid;grid-template-columns:112px 1fr;gap:9px;align-items:center;padding:10px;background:var(--cream);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow)}
.ponkichi-stage{height:127px;position:relative;display:grid;place-items:center;overflow:visible}.ponkichi-character{width:104px;height:136px;object-fit:contain;transform-origin:50% 90%;animation:breathe 2.8s ease-in-out infinite}.ponkichi-name{position:absolute;left:4px;right:4px;bottom:-2px;padding:3px 5px;border-radius:999px;background:#173e36;color:#fff;text-align:center;font-size:9px;font-weight:800}.mood-happy .ponkichi-character{animation:happyHop .8s ease,breathe 2.8s .8s ease-in-out infinite}.mood-panic .ponkichi-character{animation:panicShake .32s linear 4,breathe 2.8s 1.4s ease-in-out infinite}.mood-worried .ponkichi-character{filter:saturate(.85)}.action-calculatorTap:after{content:"🧮";position:absolute;right:3px;bottom:8px;font-size:24px;animation:calculatorTap .7s ease-in-out infinite}.action-binderPresent .ponkichi-character{animation:binderPresent 1s ease,breathe 2.8s 1s ease-in-out infinite}.speech-bubble{padding:11px 12px;border-radius:18px;background:#edf5f1;position:relative}.speech-bubble:before{content:"";position:absolute;left:-9px;top:44px;border-width:9px 10px 9px 0;border-style:solid;border-color:transparent #edf5f1 transparent transparent}.speech-bubble b{font-size:11px;color:var(--green)}.speech-bubbl