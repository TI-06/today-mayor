.app-shell{min-height:calc(100svh - 36px);border-radius:29px;box-shadow:0 30px 90px rgba(20,55,49,.18)}.bottom-nav{bottom:18px;border-radius:0 0 29px 29px}.action-sheet{margin:auto;border-radius:27px;max-height:88svh}.sheet-body{max-height:calc(88svh - 69px)}}
@media(max-width:370px){.money-bar{grid-template-columns:1.2fr .95fr auto;padding-inline:9px;gap:5px}.money-main strong{font-size:15px}.money-sub{font-size:9px}.view{padding-inline:10px}.metric-strip{gap:3px}.metric-strip article{padding-inline:3px}.focus-grid,.focus-sheet-grid,.district-grid,.resident-grid{gap:6px}.bottom-nav{padding-inline:4px}.nav-item small{font-size:8px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important}}
.term-goal-list{display:grid;gap:7px}.term-goal{display:flex;align-items:center;gap:9px;padding:10px}.term-goal>span{width:27px;height:27px;border-radius:50%;display:grid;place-items:center;background:#e5f1ec;color:var(--green);font-weight:900}.term-goal b{display:block;font-size:11px}.term-goal small{font-size:9px;color:var(--muted)}.term-goal.status-completed{background:#eaf6ee}.term-goal.status-failed{background:#fff0ed}
.auto-report{padding:13px}.auto-report>div:last-child{display:grid;gap:5px}.auto-report p{display:flex;align-items:center;justify-content:space-between;margin:0;padding:6px 8px;border-radius:10px;background:#f3f7f5;font-size:10px}.auto-report p b{color:var(--danger)}
