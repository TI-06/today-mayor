mplate-columns:repeat(2,minmax(0,1fr));gap:8px}.district-card,.resident-card{padding:11px}.district-card header,.project-card header{display:flex;gap:8px;align-items:center}.district-card header>span,.project-card header>span{font-size:25px}.district-card b,.resident-card b,.project-card b{display:block;font-size:12px}.district-card small,.resident-card small,.project-card small{display:block;font-size:9px;color:var(--muted)}.small-action,.text-action,.icon-action{border:0;border-radius:12px;background:#e5f1ec;color:var(--green);font-weight:800}.small-action{width:100%;min-height:44px;margin-top:9px;padding:8px;font-size:10px}.small-action small{display:block}.text-action{padding:8px 10px}.icon-action{width:44px;height:44px}.project-list,.policy-list,.story-list,.news-list,.ranking-list,.ledger-list,.project-catalog{display:grid;gap:8px}.project-row,.recurring-row,.ranking-row{display:flex;align-items:center;gap:10px;padding:11px}.project-row>span{font-size:25px}.project-row>div,.recurring-row>div,.ranking-row>div{flex:1;min-width:0}.project-row b,.recurring-row b,.ranking-row strong{font-size:12px}.project-row small,.recurring-row small,.ranking-row small{display:block;font-size:9px;color:var(--muted)}
