k;font-size:12px;margin:4px 0}.focus-card small{font-size:9px;line-height:1.45;color:var(--muted)}.focus-card.selected{border-color:#57a187;background:#edf7f3;box-shadow:inset 0 0 0 1px #57a187}.segmented{display:grid;grid-template-columns:repeat(2,1fr);gap:6px}.segmented button{min-height:44px;border:1px solid var(--line);border-radius:13px;background:#fff;color:var(--muted);font-size:10px}.segmented button.selected{background:var(--green);border-color:var(--green);color:#fff}.project-card{padding:12px}.project-card dl,.expense-preview dl{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:11px 0 0}.project-card dl div,.expense-preview dl div{padding:7px;border-radius:11px;background:#f2f6f4}.project-card dt,.expense-preview dt{font-size:8px;color:var(--muted)}.project-card dd,.expense-preview dd{margin:2px 0 0;font-size:10px;font-weight:900}.recurring-row{justify-content:space-between}
.resident-card{display:flex;gap:9px}.resident-card>span{font-size:29px}.resident-card>div{flex:1;min-width:0;position:relative}.resident-card em{position:absolute;right:0;top:0;font-style:normal;font-weight:900;color:var(--green)}.resident-card strong{font-size:8px;color:var(--green)}.story-card{width:100%;display:flex;gap:10px;padding:12px;border:1px solid var(--line);text-align:left;background:#fff}.story-card>span{font-size:27px}.story-card b{font-size:12px}.story-card small{display:block;font-size:9px;color:var(--muted)}.story-card p{font-size:10px;line-height:1.5;margin:5px 0