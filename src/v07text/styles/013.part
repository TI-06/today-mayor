.menu-dialog{width:min(calc(100% - 28px),430px);border-radius:24px;padding:15px;max-height:88svh;overflow:auto}.menu-dialog header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.menu-status{padding:12px;border-radius:15px;background:#eef5f2;margin-bottom:10px}.menu-status b{display:block}.menu-status small{font-size:9px;color:var(--muted)}.menu-row{width:100%;min-height:48px;border:0;border-bottom:1px solid var(--line);background:transparent;text-align:left}.menu-row.danger{color:var(--danger)}.menu-dialog>button{margin-top:8px}.menu-dialog form{display:grid;gap:10px}.menu-dialog label{font-size:10px;font-weight:800}.menu-dialog input{width:100%;margin-top:5px;padding:11px;border:1px solid var(--line);border-radius:13px;background:#fff}.auth-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.form-message{padding:9px;border-radius:12px;background:#e7f1ec;color:var(--green);font-size:10px}.leaf-balance{padding:10px;border-radius:14px;background:#eef5f2;margin-bottom:9px}.cosmetic-grid{display:grid;grid-template