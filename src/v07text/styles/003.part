lock;width:25%;border:3px solid rgba(30,65,58,.4);border-bottom:0;border-radius:6px 6px 0 0;background:#eed09b;position:relative}.tower:after{content:"";position:absolute;inset:12px 8px;background:repeating-linear-gradient(#3e7e75 0 5px,transparent 5px 13px)}.tower-a{height:68px}.tower-b{height:92px;background:#e8b87e}.tower-c{height:76px;background:#d7dec0}
.city-block{position:absolute;left:8%;bottom:45px;width:44%;height:51px;border-radius:7px 7px 0 0;background:#f5ddbd;border:3px solid rgba(38,72,65,.45);border-bottom:0}.shop-row{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;padding:16px 7px 0}.shop-window{height:19px;border-radius:3px 3px 0 0;background:#475b58}.shop-window.lit{background:#ffd96c;box-shadow:0 0 8px rgba(255,217,108,.75)}.shop-window.closed{background:#53605f;opacity:.55}
.city-road{position:absolute;left:0;right:0;bottom:0;height:47px;background:#4b5c58}.city-road:after{content:"";position:absolute;left:3%;right:3%;top:24px;border-top:2px dashed #f7edb3}.city-car,.city-truck{position:absolute;bottom:12px;width:38px;height:15px;border-radius:6px 9px 3px 3px;background:#e85d50;animation:drive 9s linear infinite}.city-car:before,.city-car:after,.city-truck:before,.city-truck:after{content:"";position:absolute;bottom:-4px;width:8px;height:8px;border-radius:50%;background:#1f2b2a}.city-car:before,.city-truck:before{left:5px}.city-car:after,.city-truck:after{right:5px}.city-truck{width:46px;background:#e5b956;animation-delay:var(--delay)}
.city-tree