 0;color:#485c57}
.finance-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.finance-summary>div{padding:8px;border-radius:12px;background:#f2f6f4}.finance-summary span{display:block;font-size:9px;color:var(--muted)}.finance-summary b,.finance-summary strong{font-size:12px}.finance-summary .balance{background:#e6f2ed}.ledger-list article,.news-card{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px;border-bottom:1px solid var(--line)}.ledger-list b,.news-card b{font-size:11px}.ledger-list small,.news-card small{display:block;font-size:8px;color:var(--muted)}.ledger-list strong{white-space:nowrap;font-size:11px}.ledger-list .income{color:var(--green)}.ledger-list .expense{color:var(--danger)}.news-card{align-items:flex-start;border:1px solid var(--line);border-radius:16px;background:#fff}.news-card>span{padding:4px 6px;border-radius:999px;background:#e7f0ec;color:var(--green);font-size:8px;font-weight:900}.news-card>div{flex:1}.news-card p{font-size:10px;line-height:1.5;margin:4px 0}.ranking-row>b{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:#e7f0ec;color:var(--green)}.ranking-row em{font-size:10px;font-style:normal;font-weight:900}
.empty-state{padding:23px 15px;border-radius:17px;background:#f2f6f4;color:var(--muted);font-size:11px;text-align:center}.game-over-panel{padding:36px 20px;text-align:center;background:#fff;border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)