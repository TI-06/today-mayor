4px 7px;border-radius:999px;background:var(--danger);color:#fff;font-size:9px;font-weight:900}.breaking-card b{font-size:12px}.breaking-card p{font-size:10px;margin:3px 0;color:#715b56}.summary-mini>div{display:flex;gap:9px;flex-wrap:wrap;font-size:10px}.summary-mini b{color:var(--green)}
.primary-action,.secondary-action,.danger-action{width:100%;min-height:50px;border:0;border-radius:17px;padding:13px 14px;font-weight:900}.primary-action{background:linear-gradient(135deg,var(--green),var(--green-2));color:#fff;box-shadow:0 10px 21px rgba(23,100,86,.25)}.secondary-action{background:#e5f1ec;color:var(--green)}.danger-action{background:#ffe8e3;color:var(--danger)}.phase-action{position:fixed;left:50%;bottom:calc(82px + env(safe-area-inset-bottom));transform:translateX(-50%);width:min(calc(100% - 26px),494px);z-index:45}
.bottom-nav{position:fixed;left:50%;bottom:0;transform:translateX(-50%);width:min(100%,520px);height:76px;padding:7px 8px calc(7px + env(safe-area-inset-bottom));display:grid;grid-template-columns:repeat(5,1fr);gap:3px;background:rgba(255,255,255,.96);backdrop-filter:blur(18px);border-top:1px solid var(--line);z-index:50}.nav-item{min-width:44px;min-height:48px;border:0;border-radius:14px;background:transparent;color:#71847e;display:grid;place-items:center;padding:2px}.nav-item span{font-size:20px;line-height:1}.nav-item small{font-size:9px}.nav-item.active{background:#e2f0ea;color:var(--green);font-weight:900}
