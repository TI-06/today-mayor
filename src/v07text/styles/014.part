-columns:repeat(2,1fr);gap:8px}.cosmetic-card{padding:10px;border:1px solid var(--line);border-radius:15px;background:#fff}.cosmetic-card span{font-size:27px}.cosmetic-card b{display:block;font-size:10px}.cosmetic-card small{font-size:8px;color:var(--muted)}.cosmetic-card.selected{border-color:#4f987f;background:#edf7f3}
.toast{position:fixed;left:50%;bottom:calc(88px + env(safe-area-inset-bottom));transform:translate(-50%,20px);width:min(calc(100% - 30px),450px);padding:11px 14px;border-radius:15px;background:#173e36;color:#fff;font-size:11px;opacity:0;pointer-events:none;transition:.25s;z-index:90}.toast.show{opacity:1;transform:translate(-50%,0)}.toast.warning{background:#805538}
@keyframes cloudMove{to{transform:translateX(680px)}}@keyframes drive{from{left:-55px}to{left:110%}}@keyframes sunPulse{50%{transform:scale(1.08);filter:brightness(1.08)}}@keyframes walkBob{to{transform:translateY(-2px)}}@keyframes craneSwing{50%{transform:rotate(3deg)}}@keyframes floodWave{50%{transform:translateY(4px)}}@keyframes breathe{50%{transform:translateY(-3px) scale(1.01)}}@keyframes happyHop{45%{transform:translateY(-13px) scale(1.04)}}@keyframes panicShake{25%{transform:translateX(-5px) rotate(-2deg)}75%{transform:translateX(5px) rotate(2deg)}}@keyframes binderPresent{40%{transform:translateY(-5px) rotate(-2deg)}}@keyframes calculatorTap{50%{transform:translateY(-4px) rotate(-4deg)}}@keyframes pulse{50%{opacity:.35}}
@media(min-width:560px){body{padding:18px}.phase-action{bottom:100px}