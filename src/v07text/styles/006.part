e p{margin:5px 0 0;font-size:12px;line-height:1.65}
.metric-strip{display:grid;grid-template-columns:repeat(5,1fr);gap:5px}.metric-strip article{min-width:0;padding:8px 5px;background:#fff;border:1px solid var(--line);border-radius:14px}.metric-strip span{display:block;font-size:8px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.metric-strip strong{display:block;font-size:17px;margin:3px 0}.metric-strip i,.progress,.relationship{display:block;height:5px;border-radius:999px;background:#e1ebe6;overflow:hidden}.metric-strip i b,.progress i,.relationship i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#2e8d75,#82bc88)}
.section-heading{margin-top:5px}.section-heading h2{font-size:16px}
.goal-panel,.summary-mini,.finance-summary{padding:14px}.goal-list{display:grid;gap:7px}.goal-item{display:flex;align-items:center;gap:9px;padding:8px;border-radius:13px;background:#f3f7f5}.goal-item>span{width:25px;height:25px;border-radius:50%;display:grid;place-items:center;background:#dcebe5;color:var(--green);font-weight:900}.goal-item b{display:block;font-size:12px}.goal-item small{font-size:9px;color:var(--muted)}.goal-item.status-completed{background:#e7f5eb}.goal-item.status-failed{background:#fff0ed}.goal-item.status-failed>span{background:#f5d3cd;color:var(--danger)}
