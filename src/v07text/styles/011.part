}.game-over-panel>span{font-size:55px}.game-over-panel>p:first-of-type{letter-spacing:.18em;font-size:9px;color:var(--muted)}
.action-sheet,.menu-dialog{border:0;padding:0;background:var(--cream);color:var(--ink);box-shadow:0 -20px 70px rgba(12,38,33,.28)}.action-sheet{width:min(100%,520px);max-width:none;max-height:91svh;margin:auto 0 0;border-radius:27px 27px 0 0}.action-sheet::backdrop,.menu-dialog::backdrop{background:rgba(8,29,25,.58);backdrop-filter:blur(5px)}.sheet-grabber{width:42px;height:5px;border-radius:999px;background:#c5d0cb;margin:9px auto 3px}.sheet-header{position:sticky;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;padding:10px 15px;background:rgba(255,253,248,.95);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}.sheet-header p,.menu-dialog header p{font-size:8px;letter-spacing:.18em;color:var(--muted);margin:0 0 2px}.sheet-header h2,.menu-dialog header h2{font-size:19px;margin:0}.close-action,.menu-dialog header button{width:38px;height:38px;border:0;border-radius:50%;background:#ebf1ee;color:var(--ink);font-size:20px}.sheet-body{padding:14px 14px calc(22px + env(safe-area-inset-bottom));overflow:auto;max-height:calc(91svh - 69px);display:grid;gap:14px}.sheet-section{display:grid;gap:9px}.sheet-section h3{font-size:14px;margin:0}.sheet-section>p{font-size:11px;line-height:1.6;margin:0;color:var(--muted)}.choice-list,.manifesto-list{display:grid;gap:8px}.choice-card{width:100%;display:flex;align-items:flex-star