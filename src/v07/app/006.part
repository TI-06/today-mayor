{
  const storyNodes=availableStoryNodes(state);
  const availableProjects=PROJECTS.filter(project=>state.week>=project.unlockWeek&&!state.activeProjects.some(item=>item.id===project.id)&&!state.completedProjects.includes(project.id));
  const stories=storyNodes.length?`<section class="sheet-section"><h3>住民からの相談</h3>${storyNodes.map(node=>`<button class="choice-card" data-sheet-story="${node.storyId}" data-sheet-node="${node.id}"><span>💬</span><div><b>${escapeHtml(node.title)}</b><small>${escapeHtml(node.storyTitle)}</small><p>${escapeHtml(node.body)}</p></div></button>`).join('')}</section>`:'';
  const projects=`<section class="sheet-section"><h3>大型プロジェクト</h3><div class="choice-list">${availableProjects.slice(0,4).map(project=>`<button class="choice-card" data-sheet-project="${project.id}"><span>${project.icon}</span><div><b>${escapeHtml(project.name)}</b><small>初期 −${formatMoney(project.initialCost)}／毎週 −${formatMoney(project.weeklyCost)}／${project.durationWeeks}週</small><p>${escapeHtml(project.description)}</p><strong>実施後 ${formatMoney(state.treasury-project.initialCost)}</strong></div></button>`).join('')||'<div class="empty-state">開始できる新規事業はありません。</div>'}</div></section>`;
  openSheet('事業と住民相談',`${stories}${projects}<button class="secondary-action" data-skip-project>今週は新規事業を始めない</button>`);
}

