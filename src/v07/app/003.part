sidents','👥','市民'],['records','📰','記録']
  ].map(([id,icon,label])=>`<button class="nav-item ${activeTab===id?'active':''}" data-tab="${id}"><span>${icon}</span><small>${label}</small></button>`).join('')}</nav>`;
}

function openFocusSheet(){
  const manifesto=!state.manifesto?`<section class="sheet-section"><h3>最初の選挙公約</h3><p>任期中に達成を目指す公約を1つ選びます。</p><div class="manifesto-list">${MANIFESTOS.map(item=>`<button class="choice-card" data-manifesto="${item.id}"><span>🗳️</span><div><b>${escapeHtml(item.label)}</b><small>${escapeHtml(item.description)}</small></div></button>`).join('')}</div></section>`:'';
  const focuses=`<section class="sheet-section"><h3>今週の重点方針</h3><p>税収、イベント、市民反応、ポン吉の自動処理に影響します。</p><div class="focus-sheet-grid">${FOCUS_OPTIONS.map(item=>`<button class="focus-card ${state.weeklyFocus===item.id?'selected':''}" data-sheet-focus="${item.id}" ${!state.manifesto?'disabled':''}><span>${item.icon}</span><b>${escapeHtml(item.label)}</b><small>${escapeHtml(item.description)}</small></button>`).join('')}</div></section>`;
  openSheet('週の方針',manifesto+focuses);
}

function openPolicySheet(){
  const policy=uiState.currentPolicyId?getPolicyCase(uiState.currentPolicyId):choosePolicyCase(state,Math.random);
  uiState.currentPolicyId=policy.id;
  const choices=policy.choices.map(option=>`<button class="choice-card policy-choice" data-policy-choice="${option.id}"><span>${policy.icon}</span><div><b>${escapeHtml(option.label)}</b><small>初期 −${formatMoney(option.initialCost)}／毎週 −${formatMoney(option.weeklyCost)}</small><p>${escapeHtml(option.knownEffect)}</p><em>未確認：${escapeHtml(option.uncertainty)}</em><